APP_ENV=dev
DB_PATH=outputs/platform.sqlite
KB_DIR=data/knowledge_base
INDEX_DIR=artifacts/index
MODEL_REGISTRY_PATH=artifacts/model_registry.json
GENERATION_BACKEND=extractive
MODEL_NAME=microsoft/Phi-3-mini-4k-instruct
MODEL_ADAPTER_PATH=
EMBEDDING_BACKEND=tfidf
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANK_BACKEND=heuristic
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
TOP_K_CANDIDATES=20
TOP_K_FINAL=5
RETRIEVAL_GATE=0.60
TFIDF_RETRIEVAL_GATE=0.15
BASE_CONFIDENCE_THRESHOLD=0.68

# Private capstone artifacts for optional GPU mode
FAISS_INDEX_PATH=artifacts/index/guidelines.faiss
FAISS_METADATA_PATH=artifacts/index/metadata.json
FAISS_BUILD_INFO_PATH=artifacts/index/build_info.json
GUIDELINE_CHUNKS_PATH=data/knowledge_base/guideline_chunks.jsonl
EMBEDDING_DEVICE=cpu

FAISS_SEARCH_MODE=semantic
RERANK_DEVICE=cpu
MAX_NEW_TOKENS=160

VERIFICATION_BACKEND=lexical
NLI_MODEL=cross-encoder/nli-deberta-v3-small
NLI_DEVICE=cpu
NLI_ENTAILMENT_THRESHOLD=0.80
NLI_CONTRADICTION_THRESHOLD=0.80
