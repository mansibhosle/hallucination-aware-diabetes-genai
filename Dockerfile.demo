FROM python:3.11-slim
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY src ./src
COPY scripts/bootstrap_demo.py ./scripts/bootstrap_demo.py
RUN python scripts/bootstrap_demo.py && useradd --create-home --uid 10001 demo
USER demo
EXPOSE 8501
CMD ["python","-m","streamlit","run","src/ui/secure_demo.py","--server.address=0.0.0.0","--server.port=8501","--server.headless=true"]
